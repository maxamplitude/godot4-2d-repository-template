; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Your Game Name"
run/main_scene="res://src/scenes/main.tscn"
config/features=PackedStringArray("4.5")

[audio]

buses/default_bus_layout="uid://c1d601b5wrpco"

[autoload]

AudioManager="*res://src/autoloads/audio_manager.gd"
EventBus="*res://src/autoloads/event_bus.gd"
SaveManager="*res://src/autoloads/save_manager.gd"
SceneManager="*res://src/autoloads/scene_manager.gd"
SettingsManager="*res://src/autoloads/settings_manager.gd"
Constants="*res://src/autoloads/constants.gd"
InputHelper="*res://src/autoloads/input_helper.gd"
GameManager="*res://src/autoloads/game_manager.gd"

[editor_plugins]

enabled=PackedStringArray("res://addons/gdUnit4/plugin.cfg")

[gdunit]

test_root="res://src/tests"

